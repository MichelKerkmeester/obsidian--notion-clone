# Override the operator's global /specs ignore so the plugin specs live in this repo.
!/specs/
# Keep real finance-data packet + heavy working dirs OUT of the public repo.
specs/public/000-personal/
specs/**/context/
specs/**/scratch/
specs/**/research/**/lineages/
.DS_Store
node_modules/
.worktrees/

# Upstream's Chinese README is not carried in this fork.
README.zh-CN.md

# Shared AI-tooling symlinks into the Public code environment.
#
# Every one of these is an ABSOLUTE symlink into a checkout that exists on one
# machine. Committed, they are worse than useless to anyone else: they resolve to
# nothing on a fresh clone, and the link target publishes the local filesystem
# layout, home directory and username of whoever created them. Five of them were
# tracked and reached the remote before this rule existed.
.opencode
.pi
.pi-subagents
.claude
.codex
.cursor
.devin
AGENTS.md
CLAUDE.md

# Generated harness output: the Storybook build and the bench's raw samples,
# which are rewritten on every run and would keep the tree perpetually dirty.
storybook-static/
tools/bench/dist/

# Engineering references, read for behaviour only. AnyType and AppFlowy are AGPL/source-available
# and this plugin is MIT, so they are never vendored, copied from, or shipped — cloned locally to
# study interaction semantics and deliberately kept out of the repository.
external/

# Deep-loop lineage runtime state. A dispatched CLI writes its own home here —
# sqlite databases, downloaded system skills, lock files, and on some runtimes a
# linked credential. It is regenerable, it is large, and a credential must never
# reach history. The artifacts worth keeping (state, prompts, reports) sit beside it.
specs/**/lineages/*/.codex-home/
# Deep-loop lineage working directories, under review/ as well as research/.
# A lineage runs a CLI executor inside its own directory, so the executor drops its whole
# runtime there: a config naming this machine's absolute home path, an installation UUID,
# multi-megabyte sqlite databases with their write-ahead logs, and vendored skills under a
# different licence than this repository. None of that is evidence and none of it belongs in
# a public tree. The lineage's own findings live in files beside these and stay tracked.
specs/**/review/**/lineages/*/.codex-runtime/
specs/**/lineages/*/.codex-runtime/
specs/**/lineages/*/.tmp/
specs/**/lineages/**/*.sqlite
specs/**/lineages/**/*.sqlite-wal
specs/**/lineages/**/*.sqlite-shm

# Deep-loop lineage internals. A lineage's evidence is its report, its findings registry, its
# per-iteration deltas and the run summary — those stay tracked and are what the packet cites.
# Everything else it emits is machinery: event streams, logs, audit and effect ledgers, dispatch
# receipts, prompt copies, lock files, and archived copies of a previous run. Several hundred files
# per run, none of it read by anyone, all of it noise in a public tree.
specs/**/lineages/*/events/
specs/**/lineages/*/logs/
specs/**/lineages/*/prompts/
specs/**/lineages/*/_archive/
specs/**/lineages/*/dispatch-receipts/
specs/**/lineages/*/locks-and-fencing-v1/
specs/**/lineages/*/deep-*-ledger/
specs/**/lineages/*/deep-*-audit-ledger/
specs/**/lineages/*/deep-*-effect-ledger/
specs/**/lineages/*/observability-events.jsonl

# Shared repo rules symlinked from the Public monorepo. Local rule files
# and the router beside them stay tracked; only the links are ignored.
repo-rules/blast-radius.md
repo-rules/communication.md
repo-rules/delegation-and-orchestration.md
repo-rules/evidence-and-proof.md
repo-rules/hub-routing.md
repo-rules/overengineering.md
repo-rules/root-cause.md
repo-rules/scope-discipline.md
repo-rules/uncertainty-and-honesty.md
