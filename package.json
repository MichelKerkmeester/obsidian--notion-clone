{
  "name": "obsidian-note-database",
  "version": "1.4.1",
  "description": "Database views for notes with table, board, gallery, list, chart, calendar, timeline, inline markdown, formulas, and source rules.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.ts\" --ignore-pattern \"src/__tests__/**\" --ignore-pattern \"**/*.stories.ts\"",
    "lint:all": "eslint src/",
    "screenshots": "node tools/screenshots/capture.mjs",
    "screenshots:verify": "node tools/screenshots/verify.mjs",
    "storybook:verify": "node tools/storybook/verify-shim.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "bench": "node tools/bench/run.mjs",
    "bench:list": "node tools/bench/run-list.mjs",
    "build-storybook": "storybook build",
    "story:smoke": "node tools/storybook/smoke.mjs",
    "story:coverage": "node tools/storybook/story-coverage.mjs",
    "story:new": "node tools/storybook/new-story.mjs",
    "shim:coverage": "node tools/storybook/verify-coverage.mjs",
    "storybook:placement": "node tools/storybook/verify-placement.mjs",
    "guard:assertions": "node tools/live/guard-inverted-assertions.mjs",
    "census:tokens": "node tools/live/token-census.mjs",
    "census:cascade": "node tools/live/cascade-audit.mjs",
    "lint:tools": "eslint \"tools/**/*.mjs\"",
    "screenshots:scan-pinned": "node tools/screenshots/scan-pinned-values.mjs",
    "gate": "node tools/gate.mjs",
    "lane:check": "node tools/lane/check-lane.mjs",
    "engine:parity": "node tools/live/engine-parity.mjs",
    "replay": "node tools/live/replay.mjs"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "database",
    "table",
    "kanban",
    "gallery",
    "list",
    "frontmatter"
  ],
  "author": "pangy9",
  "license": "MIT",
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-themes": "^10.5.10",
    "@storybook/html-vite": "^10.5.10",
    "@types/node": "^22.0.0",
    "@typescript-eslint/parser": "^8.60.1",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.3.0",
    "obsidian": "^1.8.7",
    "playwright-core": "^1.62.1",
    "storybook": "^10.5.10",
    "typescript": "^5.7.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "chart.js": "^4.5.1"
  }
}
